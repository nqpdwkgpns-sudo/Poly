{
  "name": "polymarket-alpha-bot",
  "version": "1.0.0",
  "description": "Production-grade Polymarket algorithmic trading bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dashboard": "cd src/dashboard && pnpm dev",
    "backtest": "tsx src/backtest/runner.ts"
  },
  "dependencies": {
    "@polymarket/clob-client": "^4.0.0",
    "axios": "^1.7.2",
    "axios-retry": "^4.4.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "p-limit": "^5.0.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# Polymarket
POLYMARKET_API_KEY=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Wallet
PHANTOM_PRIVATE_KEY=  # base58 encoded private key
POLYGON_RPC_URL=https://polygon-rpc.com

# Strategy
MAX_POSITION_USDC=500
KELLY_FRACTION=0.25     # fractional Kelly for safety
MIN_EDGE_THRESHOLD=0.03 # min 3% edge to trade
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_USDC=200

# Monitoring
TELEGRAM_BOT_TOKEN=     # optional alerts
TELEGRAM_CHAT_ID=

# Environment
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001

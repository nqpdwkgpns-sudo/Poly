# =====================
# Polymarket
# =====================
POLYMARKET_API_KEY=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# =====================
# Wallet (Phantom-compatible private key, base58 encoded)
# Polymarket settles on Polygon; Phantom multichain exports the EVM key.
# =====================
PHANTOM_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# =====================
# Strategy
# =====================
MAX_POSITION_USDC=500
KELLY_FRACTION=0.25
MIN_EDGE_THRESHOLD=0.03
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_USDC=200
PROFIT_TARGET_PCT=0.15
STOP_LOSS_PCT=0.08
MAX_DRAWDOWN_PCT=0.20

# =====================
# Monitoring
# =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_SERVER_PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# =====================
# Optional external probability APIs
# =====================
METACULUS_API_URL=https://www.metaculus.com/api2
